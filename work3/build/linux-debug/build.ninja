  POST_BUILD = cd /work/build/linux-debug && /usr/bin/cmake -D TEST_TARGET=geometry_tests -D TEST_EXECUTABLE=/work/build/linux-debug/geometry_tests -D TEST_EXECUTOR= -D TEST_WORKING_DIR=/work/build/linux-debug -D TEST_EXTRA_ARGS= -D TEST_PROPERTIES= -D TEST_PREFIX= -D TEST_SUFFIX= -D TEST_FILTER= -D NO_PRETTY_TYPES=FALSE -D NO_PRETTY_VALUES=FALSE -D TEST_LIST=geometry_tests_TESTS -D CTEST_FILE=/work/build/linux-debug/geometry_tests[1]_tests.cmake -D TEST_DISCOVERY_TIMEOUT=5 -D TEST_DISCOVERY_EXTRA_ARGS= -D TEST_XML_OUTPUT_DIR= -P /usr/share/cmake-4.2/Modules/GoogleTestAddTests.cmake
  PRE_LINK = :
  RESTAT = 1
  TARGET_FILE = geometry_tests
  TARGET_PDB = geometry_tests.dbg
  TARGET_SUPPORT_DIR = CMakeFiles/geometry_tests.dir


